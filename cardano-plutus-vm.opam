# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha1"
synopsis: "Untyped Plutus Core terms; evaluation deliberately unimplemented"
description: """
Carries the UPLC term type and an `evaluate` that returns
`Error `Not_implemented`. Execution units come from the node's
`evaluateTransaction` in this release. The package exists so that a local CEK
machine can land later without reshaping the API around it."""
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-cardano"
bug-reports: "https://github.com/reuna-labs/ocaml-cardano/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "cardano-plutus" {= version}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-cardano.git"
