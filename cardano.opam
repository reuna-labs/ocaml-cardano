# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha1"
synopsis: "Pure OCaml Cardano SDK for Conway-era clients and signers"
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-cardano"
bug-reports: "https://github.com/reuna-labs/ocaml-cardano/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "cardano-types" {= version}
  "cardano-address" {= version}
  "cardano-crypto" {= version}
  "cardano-plutus" {= version}
  "cardano-transaction" {= version}
  "cardano-rpc" {= version}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-cardano.git"
# DEVELOPMENT ONLY -- delete this file before submitting to opam-repository.
#
# Mirage_crypto_ec.Ed25519.Primitive, and mirage-crypto-blockchain-core, are
# additions in the Reuna fork and are not yet upstream. This block lets a
# standalone `opam install --deps-only .` resolve them.
#
# The release branch is shared with the other web3 packages so every package
# in the Mirage-crypto family resolves to one tested source revision. The
# private pin is removed from the opam-repository submission after that
# prerequisite has a public archive and versioned package metadata.
pin-depends: [
  [
    "mirage-crypto.dev"
    "git+https://github.com/reuna-labs/mirage-crypto.git#release/web3-2.4.0-reuna1"
  ]
  [
    "mirage-crypto-rng.dev"
    "git+https://github.com/reuna-labs/mirage-crypto.git#release/web3-2.4.0-reuna1"
  ]
  [
    "mirage-crypto-ec.dev"
    "git+https://github.com/reuna-labs/mirage-crypto.git#release/web3-2.4.0-reuna1"
  ]
  [
    "mirage-crypto-blockchain-core.dev"
    "git+https://github.com/reuna-labs/mirage-crypto.git#release/web3-2.4.0-reuna1"
  ]
  [
    "digestif.dev"
    "git+https://github.com/reuna-labs/digestif.git#release/1.4.0-alpha1"
  ]
]
