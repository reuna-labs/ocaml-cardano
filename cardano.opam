# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0~alpha1"
synopsis: "Pure OCaml Cardano SDK for Conway-era clients and signers"
maintainer: ["Gil Bahat <bahat.gil@gmail.com>"]
authors: ["Gil Bahat <bahat.gil@gmail.com>"]
license: "ISC"
homepage: "https://github.com/reuna-labs/ocaml-cardano"
bug-reports: "https://github.com/reuna-labs/ocaml-cardano/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.6" & >= "3.6"}
  "cardano-types" {= version}
  "cardano-address" {= version}
  "cardano-crypto" {= version}
  "cardano-plutus" {= version}
  "cardano-transaction" {= version}
  "cardano-rpc" {= version}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/reuna-labs/ocaml-cardano.git"
# DEVELOPMENT ONLY -- remove before submitting to opam-repository.
# Native Cardano reference C and its matching shared Digestif SHA512 header.
# Revisions are published and tested together; no EC/RNG/blockchain umbrella.
pin-depends: [
  [
    "mirage-crypto-ed25519-bip32.dev"
    "git+https://github.com/reuna-labs/mirage-crypto.git#a81f623ab6235f5c734e02bbdb8232cb742db73e"
  ]
  [
    "digestif.1.4.0"
    "git+https://github.com/reuna-labs/digestif.git#4c33049713a1449ab5066ebe286a9c6f763d32b6"
  ]
  [
    "web3-codec-basen.0.1.0~alpha1"
    "git+https://github.com/reuna-labs/ocaml-web3-codec.git#v0.1.0-alpha1"
  ]
  [
    "web3-codec-base58.0.1.0~alpha1"
    "git+https://github.com/reuna-labs/ocaml-web3-codec.git#v0.1.0-alpha1"
  ]
  [
    "web3-codec-cbor.0.1.0~alpha1"
    "git+https://github.com/reuna-labs/ocaml-web3-codec.git#v0.1.0-alpha1"
  ]
]
